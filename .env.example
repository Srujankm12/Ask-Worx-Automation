# Copy to .env and fill in. Never commit .env.
# The service refuses to start if anything required here is missing — there are
# no silent fallbacks.

# ── Always required ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=8080

# Signs admin session tokens. At least 32 characters.
#   openssl rand -base64 48
# Changing it signs everybody out.
SESSION_SECRET=

# ── First sign-in ───────────────────────────────────────────────────────────
# Used ONCE, on a deployment with no admin accounts yet, to create the first
# one. After you have signed in, remove ADMIN_PASSWORD from the environment;
# changing it later has no effect, because the account now lives in the
# database with a bcrypt hash.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Production ──────────────────────────────────────────────────────────────
# Set ENV=production to require everything below and to enforce webhook
# signature checking.
ENV=development

# Comma-separated list of origins allowed to call the API. "*" is rejected.
# Required in production; defaults to the local panel otherwise.
CORS_ORIGINS=https://console.example.com

COMPANY_NAME=ASKworX
ADMIN_PHONE=
TEAM_WHATSAPP_NUMBER=
PUBLIC_URL=

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
ACCESS_TOKEN=
PHONE_NUMBER_ID=
# Your own string, echoed back during Meta's webhook handshake.
VERIFY_TOKEN=
# App secret from the Meta dashboard. Used to verify X-Hub-Signature-256 on
# every incoming webhook. Required in production.
META_APP_SECRET=
