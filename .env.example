# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=8080

# Sign-in password for the admin panel.
ADMIN_PASSWORD=
# Bearer token the admin panel sends on every /api request.
# There is a hardcoded fallback in admin.go — always set this explicitly.
API_SECRET=

COMPANY_NAME=ASKworX
ADMIN_PHONE=
TEAM_WHATSAPP_NUMBER=
PUBLIC_URL=

# WhatsApp Cloud API
ACCESS_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
